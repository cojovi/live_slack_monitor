# Slack API authentication
# Provide at least one Slack token with the listed scopes so the app can poll your presence.
# The hook will use the first non-empty token in this order:
#   1. VITE_SLACK_BOT_TOKEN (requires users:read, users.profile:read, users:read.presence, dnd:read)
#   2. VITE_SLACK_USER_TOKEN (requires the same scopes)
#   3. VITE_SLACK_TOKEN (legacy fallback for existing setups)
# Only one token is required, but you may supply multiple if you prefer; the priority above will be used.
VITE_SLACK_BOT_TOKEN=
VITE_SLACK_USER_TOKEN=
VITE_SLACK_TOKEN=

# Optional: explicitly set the Slack user ID to mirror. Leave blank to mirror the user associated with the token.
VITE_SLACK_USER_ID=
