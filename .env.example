# Slack Integration
VITE_SLACK_CLIENT_ID=your_slack_client_id_here
VITE_SLACK_CLIENT_SECRET=your_slack_client_secret_here
VITE_SLACK_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# WebSocket Configuration
VITE_WS_URL=ws://localhost:8080
VITE_WS_RECONNECT_INTERVAL=5000

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=10000

# Authentication
VITE_JWT_SECRET=your_jwt_secret_here
VITE_SESSION_TIMEOUT=3600000

# Database (if using backend)
DATABASE_URL=postgresql://user:password@localhost:5432/slack_presence
REDIS_URL=redis://localhost:6379

# Development
VITE_DEV_MODE=true
VITE_LOG_LEVEL=debug

# Production
VITE_PROD_URL=https://your-production-domain.com
VITE_SENTRY_DSN=your_sentry_dsn_here

# Features
VITE_ENABLE_ANIMATIONS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_BACKGROUND_SYNC=true

# Slack Events API
VITE_SLACK_EVENTS_URL=https://your-app.herokuapp.com/slack/events
VITE_SLACK_OAUTH_URL=https://slack.com/oauth/v2/authorize

# Performance
VITE_ANIMATION_FPS=60
VITE_REDUCED_MOTION_THRESHOLD=500
VITE_CACHE_TTL=300000

# Security
VITE_CORS_ORIGIN=http://localhost:5173
VITE_RATE_LIMIT_WINDOW=900000
VITE_RATE_LIMIT_MAX=100